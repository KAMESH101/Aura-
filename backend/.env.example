# ─── Aura AI (Groq Edition) — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to git.

# ✅ Groq API Key — FREE, no credit card needed
# Get yours at: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# 🤖 Groq Model Selection (optional — defaults to llama-3.1-8b-instant)
# Options:
#   llama-3.1-8b-instant     → FASTEST,  14,400 req/day free  ✅ recommended
#   llama-3.3-70b-versatile  → SMARTER,   1,000 req/day free
#   mixtral-8x7b-32768       → BALANCED,  1,000 req/day free
#   gemma2-9b-it             → GOOGLE,   14,400 req/day free
GROQ_MODEL=llama-3.1-8b-instant

# ✅ OpenWeatherMap API Key — FREE, no credit card needed
# Get yours at: https://openweathermap.org/api → Sign up → My API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server port (optional, defaults to 3001)
PORT=3001

# Frontend URL for CORS (optional, defaults to http://localhost:3000)
FRONTEND_URL=http://localhost:3000
